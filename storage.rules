rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Cho phép đọc tất cả các file
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Cho phép tải lên ảnh đại diện
    match /avatars/{userId}/{filename} {
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size < 5 * 1024 * 1024; // 5MB giới hạn
    }
    
    // Cho phép tải lên ảnh bài đăng
    match /posts/{userId}/{filename} {
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.contentType.matches('image/.*')
                   && request.resource.size < 10 * 1024 * 1024; // 10MB giới hạn
    }
  }
}